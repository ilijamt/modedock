      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "het profiel"
          }
        }
      }
    },
    "⇧⌘3 captures the screen and ⇧⌘4 an area, with ModeDock's settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ModeDockの設定で、⇧⌘3は画面を、⇧⌘4は範囲をキャプチャします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘3 neemt het scherm op en ⇧⌘4 een gebied, met de instellingen van ModeDock."
          }
        }
      }
    },
    "⌃⌘Q": {
      "localizations": {
        "ja": {
          "stringUnit": {
