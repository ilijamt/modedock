        }
      }
    },
    "Using ⇧⌘3 and ⇧⌘4 here turns off the matching macOS shortcuts until you switch this off." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで⇧⌘3と⇧⌘4を使うと、この設定をオフにするまで対応するmacOSのショートカットがオフになります。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користењето ⇧⌘3 и ⇧⌘4 тука ги исклучува соодветните кратенки на macOS додека не го исклучите ова."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je ⇧⌘3 en ⇧⌘4 hier gebruikt, staan de bijbehorende macOS-sneltoetsen uit tot je dit uitzet."
          }
        }
      }
    },
