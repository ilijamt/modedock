    },
    "After allowing ModeDock in System Settings, you may need to reopen it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定でModeDockを許可したあと、再度開く必要がある場合があります。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откако ќе го дозволите ModeDock во System Settings, можеби ќе треба повторно да го отворите."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat je ModeDock in Systeeminstellingen hebt toegestaan, moet je het mogelijk opnieuw openen."
          }
        }
      }
    },
