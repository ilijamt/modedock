            "value" : "Vensterschaduw"
          }
        }
      }
    },
    "Writes a detailed log to ~/Library/Logs/ModeDock/ModeDock.log. Turn it on, repeat the problem and attach the log to your bug report. It never includes serial numbers or file contents and stays under about 4 MB." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/Library/Logs/ModeDock/ModeDock.logに詳細なログを書き込みます。オンにして問題を再現し、バグ報告にログを添付してください。シリアル番号やファイルの内容は含まれず、サイズは約4 MB以下に保たれます。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишува детален дневник во ~/Library/Logs/ModeDock/ModeDock.log. Вклучете го, повторете го проблемот и приложете го дневникот кон пријавата за грешка. Никогаш не содржи сериски броеви или содржина на датотеки и останува под околу 4 MB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft een gedetailleerd log naar ~/Library/Logs/ModeDock/ModeDock.log. Zet het aan, herhaal het probleem en voeg het log toe aan je foutmelding. Het bevat nooit serienummers of bestandsinhoud en blijft onder ongeveer 4 MB."
          }
        }
      }
    },
    "github.com/ilijamt/modedock" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "github.com/ilijamt/modedock"
          }
        },
