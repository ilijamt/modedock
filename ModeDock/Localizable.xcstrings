    "%@ has no brightness control, so ModeDock dims the picture." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には輝度調整がないため、ModeDockが画面を暗くします。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ нема контрола на осветленоста, па ModeDock ја затемнува сликата."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft geen helderheidsregeling, dus ModeDock dimt het beeld."
          }
        }
      }
    },
