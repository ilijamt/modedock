      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Venster"
          }
        }
      }
    },
    "Window shadow": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの影"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vensterschaduw"
          }
        }
      }
    },
    "Write a debug log": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグログを書き出す"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een foutopsporingslog"
          }
        }
      }
    },
    "Writes a detailed log to ~/Library/Logs/ModeDock/ModeDock.log. Turn it on, repeat the problem and attach the log to your bug report. It never includes serial numbers or file contents and stays under about 4 MB.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Logs/ModeDock/ModeDock.logに詳細なログを書き込みます。オンにして問題を再現し、バグ報告にログを添付してください。シリアル番号やファイルの内容は含まれず、サイズは約4 MB以下に保たれます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijft een gedetailleerd log naar ~/Library/Logs/ModeDock/ModeDock.log. Zet het aan, herhaal het probleem en voeg het log toe aan je foutmelding. Het bevat nooit serienummers of bestandsinhoud en blijft onder ongeveer 4 MB."
          }
        }
      }
    },
    "github.com/ilijamt/modedock": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "github.com/ilijamt/modedock"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "github.com/ilijamt/modedock"
          }
        }
      }
    },
    "macOS keys:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのキー："
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-toetsen:"
          }
        }
      }
    },
    "macOS leaves the pointer out, so ModeDock draws it in. It may be slightly off with window shadows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはポインタを含めないため、ModeDockが描画します。ウインドウの影があると少しずれることがあります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS laat de aanwijzer weg, dus ModeDock tekent hem erin. Met vensterschaduw kan hij iets verschoven zijn."
          }
        }
      }
    },
    "tab.utilities": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilities"
          }
        },
