          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachttijd voor de opname"
          }
        }
      }
    },
    "Wake": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ解除"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wek"
          }
        }
      }
    },
    "Wake the monitor over DDC.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DDCでモニタをスリープ解除します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wek de monitor via DDC."
          }
        }
      }
    },
    "Warmer colours on every screen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての画面の色を暖色にします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmere kleuren op elk scherm."
          }
        }
      }
    },
    "When off, screens can sleep while the Mac stays awake.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、Macが起動したまま画面はスリープできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien uit kunnen schermen sluimeren terwijl de Mac wakker blijft."
          }
        }
      }
    },
    "When these exact screens are connected. Only one profile per set of screens can do this.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これと同じディスプレイが接続されたとき。同じディスプレイの組み合わせにつき1つのプロファイルのみ設定できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als precies deze schermen zijn aangesloten. Dit kan maar één profiel per set schermen."
          }
        }
      }
    },
    "Where screenshots go and how they're taken": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットの保存先と撮影方法"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar schermafbeeldingen heen gaan en hoe ze worden gemaakt"
          }
        }
      }
    },
