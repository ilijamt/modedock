            "value" : "github.com/ilijamt/modedock"
          }
        }
      }
    },
    "macOS leaves the pointer out, so ModeDock draws it in. It may be slightly off with window shadows." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSはポインタを含めないため、ModeDockが描画します。ウインドウの影があると少しずれることがあります。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS го изоставува покажувачот, па ModeDock го доцртува. Може малку да отстапува кај сенките на прозорците."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS laat de aanwijzer weg, dus ModeDock tekent hem erin. Met vensterschaduw kan hij iets verschoven zijn."
          }
        }
      }
    },
