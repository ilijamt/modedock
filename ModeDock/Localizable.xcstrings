            "state": "translated",
            "value": "Een bestand per scherm"
          }
        }
      }
    },
    "A standard menu, like Wi-Fi and Sound.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiやサウンドのような標準メニュー。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een standaardmenu, zoals Wi-Fi en Geluid."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
    "Adds other aspect ratios, low-resolution sizes and modes macOS hides.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの縦横比、低解像度サイズ、macOSが隠しているモードを追加します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt andere beeldverhoudingen, lage resoluties en door macOS verborgen modi toe."
          }
        }
      }
    },
    "Adjust brightness to the light around you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周囲の明るさに合わせて輝度を調整します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de helderheid aan het omgevingslicht aan."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geavanceerd"
          }
        }
      }
    },
    "After": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na"
          }
        }
      }
    },
    "After allowing ModeDock in System Settings, you may need to reopen it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でModeDockを許可したあと、再度開く必要がある場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat je ModeDock in Systeeminstellingen hebt toegestaan, moet je het mogelijk opnieuw openen."
          }
        }
      }
    },
    "After capturing:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ後："
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na opname:"
          }
        }
      }
    },
    "All On": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてオン"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles aan"
          }
        }
      }
    },
    "All Screens": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全ディスプレイ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle schermen"
          }
        }
      }
    },
    "All Screens:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全ディスプレイ："
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle schermen:"
          }
        }
      }
    },
    "All profiles": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのプロファイル"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle profielen"
          }
        }
      }
    },
    "All sections are hidden. Show some in Settings → Menu.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのセクションが非表示です。設定 → メニューで表示してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle onderdelen zijn verborgen. Toon er een paar in Instellingen → Menu."
          }
        }
      }
    },
    "All sections in one scrolling list.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのセクションを1つのスクロールリストに表示。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle onderdelen in één scrollende lijst."
          }
        }
      }
    },
    "All shortcuts except profile shortcuts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル以外のすべてのショートカット"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sneltoetsen behalve die van profielen"
          }
        }
      }
    },
    "Allow ModeDock in System Settings → Privacy & Security → Screen Recording. You may need to reopen ModeDock afterwards.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → 画面収録でModeDockを許可してください。そのあとModeDockを再度開く必要がある場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta ModeDock toe in Systeeminstellingen → Privacy en beveiliging → Schermopname. Mogelijk moet je ModeDock daarna opnieuw openen."
          }
        }
      }
    },
    "Allow Screen Recording for ModeDock in System Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でModeDockの画面収録を許可してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta schermopname voor ModeDock toe in Systeeminstellingen."
          }
        }
      }
    },
    "Allow Screen Recording?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を許可しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermopname toestaan?"
          }
        }
      }
    },
    "Allow Screen Recording…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を許可…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta schermopname toe…"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe…"
          }
        }
      }
    },
    "Also dims monitors macOS can't.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSで暗くできないモニタも暗くします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimt ook monitors die macOS niet kan dimmen."
          }
        }
      }
    },
    "Also sets:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他の設定："
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt ook in:"
          }
        }
      }
    },
    "Appearance, language, Keep Awake and debug logging": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観、言語、スリープ防止、デバッグログ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave, taal, wakker houden en foutopsporingslog"
          }
        }
      }
    },
    "Appearance:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観："
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave:"
          }
        }
      }
    },
    "Applied automatically when these exact screens are connected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これと同じディスプレイが接続されると自動で適用されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch toegepast als precies deze schermen zijn aangesloten."
          }
        }
      }
    },
    "Applies to Screen and All Screens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画面」と「全ディスプレイ」に適用されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor Scherm en Alle schermen."
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas toe"
          }
        }
      }
    },
    "Apply automatically": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に適用"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch toepassen"
          }
        }
      }
    },
    "Applying the profile switches these too. Leave as is keeps whatever they are then.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを適用すると、これらも切り替わります。「変更しない」はそのときの状態のままにします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel toepassen zet deze ook. Laten zoals het is houdt ze zoals ze op dat moment zijn."
          }
        }
      }
    },
    "Applying…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用中…"
          }
        },
        "nl": {
