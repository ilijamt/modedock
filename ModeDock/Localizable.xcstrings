    "Use as Main Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインディスプレイとして使用"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik als hoofdscherm"
          }
        }
      }
    },
    "Use ⇧⌘3 and ⇧⌘4 for ModeDock": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘3と⇧⌘4をModeDockで使用"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ⇧⌘3 en ⇧⌘4 voor ModeDock"
          }
        }
      }
    },
    "Using ⇧⌘3 and ⇧⌘4 here turns off the matching macOS shortcuts until you switch this off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで⇧⌘3と⇧⌘4を使うと、この設定をオフにするまで対応するmacOSのショートカットがオフになります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je ⇧⌘3 en ⇧⌘4 hier gebruikt, staan de bijbehorende macOS-sneltoetsen uit tot je dit uitzet."
          }
        }
      }
    },
    "Utilities": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーティリティ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hulpmiddelen"
          }
        }
      }
    },
    "Wait before capturing": {
