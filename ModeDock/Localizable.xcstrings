    "A file per screen" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイごとに1ファイル"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датотека за секој екран"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bestand per scherm"
          }
        }
      }
    },
    "A profile saves which screens are on, their resolutions, arrangement, mirroring and brightness. Missing screens are skipped. Drag to reorder." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルには、オンのディスプレイ、解像度、配置、ミラーリング、輝度が保存されます。未接続のディスプレイはスキップされます。ドラッグで並べ替えできます。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилот ги зачувува вклучените екрани, нивните резолуции, распоред, пресликување и осветленост. Екраните што недостасуваат се прескокнуваат. Повлечете за преуредување."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een profiel bewaart welke schermen aan staan, hun resolutie, ordening, synchrone weergave en helderheid. Ontbrekende schermen worden overgeslagen. Sleep om te ordenen."
          }
        }
      }
    },
    "A standard menu, like Wi-Fi and Sound." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiやサウンドのような標準メニュー。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стандардно мени, како Wi-Fi и Sound."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een standaardmenu, zoals Wi-Fi en Geluid."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "情報"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За апликацијата"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Info"
          }
        }
      }
    },
    "Adds other aspect ratios, low-resolution sizes and modes macOS hides. Some may not display correctly." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの縦横比、低解像度サイズ、macOSが隠しているモードを追加します。正しく表示されないものもあります。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додава други соодноси, ниски резолуции и режими што macOS ги крие. Некои можеби нема да се прикажат правилно."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt andere beeldverhoudingen, lage resoluties en door macOS verborgen modi toe. Sommige werken mogelijk niet goed."
          }
        }
      }
    },
    "Adjust brightness to the light around you." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周囲の明るさに合わせて輝度を調整します。"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагодете ја осветленоста според светлината околу вас."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de helderheid aan het omgevingslicht aan."
          }
        }
      }
    },
    "After" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後"
          }
        },
        "mk" : {
