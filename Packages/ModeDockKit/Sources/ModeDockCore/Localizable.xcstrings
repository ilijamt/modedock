    "Couldn't eject %@. It may be in use.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を取り出せませんでした。使用中の可能性があります。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може да се исфрли. Можеби се користи."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan %@ niet uitwerpen. Mogelijk is het in gebruik."
          }
        }
      }
    },
    "Finder's settings couldn't be saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderの設定を保存できませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставките на Finder не може да се зачуваат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instellingen van Finder konden niet worden bewaard."
          }
        }
      }
    },
    "ModeDock isn't allowed to control Finder. Allow it in System Settings → Privacy & Security → Automation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ModeDockにFinderの制御が許可されていません。システム設定 → プライバシーとセキュリティ → オートメーションで許可してください。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "ModeDock нема дозвола да го контролира Finder. Дозволете го во System Settings → Privacy & Security → Automation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ModeDock mag Finder niet bedienen. Sta het toe in Systeeminstellingen → Privacy en beveiliging → Automatisering."
          }
        }
      }
    },
    "Night Shift couldn't be changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Night Shiftを変更できませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Night Shift не може да се промени."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Night Shift kon niet worden gewijzigd."
          }
        }
      }
    },
    "The Trash couldn't be emptied.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にできませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Корпата не може да се испразни."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prullenmand kon niet worden geleegd."
          }
        }
      }
    },
    "The screens couldn't be combined into one image.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を1枚の画像に結合できませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екраните не може да се спојат во една слика."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermen konden niet tot één afbeelding worden samengevoegd."
          }
        }
      }
    },
    "The screenshot couldn't be copied to the clipboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットをクリップボードにコピーできませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сликата од екранот не може да се копира во клипбордот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermafbeelding kon niet naar het klembord worden gekopieerd."
          }
        }
      }
    },
    "The screenshot couldn't be taken.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮れませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сликата од екранот не може да се направи."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermafbeelding kon niet worden gemaakt."
          }
        }
      }
    },
    "The screenshot couldn't be taken: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮れませんでした: %@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сликата од екранот не може да се направи: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermafbeelding kon niet worden gemaakt: %@"
          }
        }
      }
    },
    "This isn't supported on this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではサポートされていません。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова не е поддржано на овој Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wordt niet ondersteund op deze Mac."
          }
        }
      }
    },
    "This isn't supported on this version of macOS.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのmacOSではサポートされていません。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова не е поддржано на оваа верзија на macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wordt niet ondersteund op deze versie van macOS."
          }
        }
      }
    },
    "True Tone couldn't be changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "True Toneを変更できませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "True Tone не може да се промени."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "True Tone kon niet worden gewijzigd."
          }
        }
      }
    },
    "Until turned off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするまで"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "До исклучување"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot je het uitzet"
          }
        }
      }
    },
    "macOS didn't carry out the request.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSが要求を実行しませんでした。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не го изврши барањето."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft het verzoek niet uitgevoerd."
          }
        }
      }
    },
    "macOS refused to keep the Mac awake.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがスリープ防止を拒否しました。"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS одби да го држи Mac буден."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS weigerde de Mac wakker te houden."
          }
        }
      }
    }
  },
  "version": "1.0"
}