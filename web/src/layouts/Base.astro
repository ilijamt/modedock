---
import "../styles/global.css";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { defaultLang, langs, ui, url, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** The page's path without the language prefix, e.g. "privacy". */
  path?: string;
  title: string;
  description: string;
}

const { lang, path = "", title, description } = Astro.props;
const t = ui[lang];
const canonical = new URL(url(lang, path), Astro.site);
const alternates = Object.fromEntries(langs.map((code) => [code, url(code, path)]));
const current = (page: string) => (page === path ? "page" : undefined);
const repo = "https://github.com/ilijamt/modedock";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((code) => <link rel="alternate" hreflang={code} href={new URL(alternates[code], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/img/icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/img/icon.png", Astro.site)} />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101013" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before the first paint, so the page doesn't flash the other theme.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <script is:inline define:vars={{ alternates, defaultLang }}>
      // A saved choice wins. Otherwise the unprefixed (English) pages follow the browser's
      // languages; a /ja/ or /nl/ link is kept as is.
      const here = document.documentElement.lang;
      let want = null;
      try {
        want = localStorage.getItem("lang");
      } catch {}
      if (!(want in alternates) && here === defaultLang) {
        // Exact tag first (pt-BR), then the same base language (pt-PT → pt-BR, zh-TW → zh-Hant).
        const codes = Object.keys(alternates);
        const base = (tag) => tag.toLowerCase().split("-")[0];
        for (const tag of navigator.languages ?? [navigator.language]) {
          want =
            codes.find((code) => code.toLowerCase() === tag.toLowerCase()) ??
            codes.find((code) => base(code) === base(tag));
          if (want) break;
        }
      }
      if (want in alternates && want !== here) location.replace(alternates[want] + location.search + location.hash);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url(lang)}>
          <img src="/img/icon.png" alt="" width="28" height="28" />
          <span>ModeDock</span>
        </a>
        <nav aria-label={t.nav.main}>
          <a href={`${url(lang)}#features`}>{t.nav.features}</a>
          <a href={url(lang, "privacy")} aria-current={current("privacy")}>{t.nav.privacy}</a>
          <a class="wide-only" href={repo}>GitHub</a>
        </nav>
        <LanguageSwitch lang={lang} alternates={alternates} />
        <ThemeSwitch lang={lang} />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p set:html={t.footer} />
        <nav aria-label={t.nav.footer}>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/releases`}>{t.nav.releases}</a>
          <a href={url(lang, "privacy")}>{t.nav.privacy}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    font-weight: 650;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand img {
    border-radius: 7px;
  }
  .bar nav {
    margin-left: auto;
    display: flex;
    gap: clamp(0.9rem, 3vw, 1.75rem);
    font-size: 0.95rem;
  }
  .bar nav a,
  .foot nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .bar nav a:hover,
  .foot nav a:hover,
  .bar nav a[aria-current="page"] {
    color: var(--text);
  }
  .bar nav a[aria-current="page"] {
    font-weight: 600;
  }
  @media (max-width: 30rem) {
    .brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .bar {
      gap: 0.6rem;
    }
    .bar nav {
      gap: 0.85rem;
      font-size: 0.9rem;
    }
    .bar nav .wide-only {
      display: none;
    }
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-block: 2rem 2.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .foot p {
    flex: 1 1 20rem;
  }
  .foot nav {
    display: flex;
    gap: 1.25rem;
  }
</style>
