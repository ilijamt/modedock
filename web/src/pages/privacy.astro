    font-size: clamp(2.25rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
  }
  .lede {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: var(--muted);
  }
  h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
  }
  p + p {
    margin-top: 0.85rem;
  }
  ul {
    margin: 0.85rem 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.6rem;
  }
  li::marker {
    color: var(--accent);
  }
  code {
    padding: 0.05rem 0.35rem;
    border-radius: 5px;
    background: var(--surface);
  }
  .updated {
    margin-top: 3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
