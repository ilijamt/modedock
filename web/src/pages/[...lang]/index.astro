---
import Base from "../../layouts/Base.astro";
import Install from "../../components/Install.astro";
import Shot from "../../components/Shot.astro";
import Stats from "../../components/Stats.astro";
import { langPaths, ui, url, type Lang } from "../../i18n/ui";

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].home;
const privacy = url(lang, "privacy");
---

<Base lang={lang} title={t.title} description={t.description}>
  <section class="hero wrap">
    <div class="intro">
      <img class="icon" src="/img/icon.png" alt="" width="96" height="96" />
      <h1>{t.heading}</h1>
      <p class="sub">{t.sub}</p>
      <Install lang={lang} />
      <p class="meta" set:html={t.meta} />
    </div>

    <div class="preview">
      <Shot tab="screens" alt={t.heroAlt} eager width={440} />
    </div>
  </section>

  <section class="features wrap" id="features">
    <h2>{t.featuresTitle}</h2>
    {
      Object.entries(t.features).map(([tab, feature]) => (
        <article class={tab === "screens" ? "feature text-only" : "feature"}>
          <div class="copy">
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
            <ul role="list">
              {feature.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
          {tab !== "screens" && (
            <div class="picture">
              <Shot tab={tab} alt="" />
            </div>
          )}
        </article>
      ))
    }

    <div class="extras">
      {
        Object.values(t.extras).map((extra) => (
          <div>
            <h3>{extra.title}</h3>
            <p>{extra.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="promise wrap">
    <h2 class="visually-hidden">{t.promiseTitle}</h2>
    <dl>
      {
        Object.values(t.promise).map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd set:html={item.text.replace("{privacy}", privacy)} />
          </div>
        ))
      }
    </dl>
  </section>

  <Stats lang={lang} />

  <section class="close wrap">
    <img src="/img/icon.png" alt="" width="64" height="64" />
    <h2>{t.closeTitle}</h2>
    <Install lang={lang} id="brew-close" />
  </section>
</Base>


<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 6vw, 4rem);
  }
  .icon {
    border-radius: 22px;
    box-shadow: var(--shadow);
  }
  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.4rem, 4.6vw, 3.5rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  :global(:lang(ja)) h1 {
    max-width: 22ch;
    letter-spacing: 0;
  }
  .sub {
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    max-width: 36rem;
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    color: var(--muted);
  }
  .meta {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  kbd {
    padding: 0.05rem 0.35rem;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .preview {
    display: grid;
    justify-items: center;
  }

  .features {
    padding-top: clamp(4rem, 9vw, 6.5rem);
  }
  .features > h2,
  .close h2 {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .feature:nth-of-type(odd) .picture {
    order: -1;
  }
  .feature.text-only {
    display: block;
  }
  .feature.text-only ul {
    max-width: none;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    column-gap: 3rem;
  }
  .feature h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }
  .feature p {
    margin-top: 0.6rem;
    max-width: 34rem;
    color: var(--muted);
  }
  .feature ul {
    margin: 1.1rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
    max-width: 34rem;
  }
  .feature li::marker {
    color: var(--accent);
  }
  .extras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .extras h3 {
    font-size: 1.1rem;
  }
  .extras p {
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .promise {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .promise dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    border-radius: var(--radius);
    background: var(--surface);
  }
  .promise dl > div {
    padding: 1.5rem 1.6rem;
  }
  .promise dl > div + div {
    border-left: 1px solid var(--line);
  }
  dt {
    font: 700 1.35rem/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }
  dd {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }

  .close {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
    padding-top: clamp(4.5rem, 10vw, 7rem);
  }
  .close :global(.install) {
    justify-content: center;
  }
  .close img {
    border-radius: 15px;
    box-shadow: var(--shadow);
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .feature .copy {
      justify-self: stretch;
    }
    .feature:nth-of-type(odd) .picture {
      order: 0;
    }
    .promise dl > div + div {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
