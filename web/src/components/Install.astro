---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** Must be unique on the page: the copy button is described by the command with this id. */
  id?: string;
}

const { lang, id = "brew" } = Astro.props;
const t = ui[lang].install;
const brew = "brew install --cask ilijamt/tap/modedock";
---

<div class="install">
  <a class="download" href="https://github.com/ilijamt/modedock/releases/latest">{t.download}</a>
  <div class="brew">
    <code id={id}><span class="prompt" aria-hidden="true">$</span> {brew}</code>
    <button type="button" class="copy" data-copy={brew} data-copied={t.copied} data-fallback={t.fallback} aria-describedby={id}>
      {t.copy}
    </button>
    <span class="visually-hidden" role="status"></span>
  </div>
</div>

<script>
  const timers = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();
  // VoiceOver skips a message identical to the last one, even after the region was emptied.
  let lastMessage = "";

  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const label = button.textContent?.trim() ?? "";
    const status = button.nextElementSibling as HTMLElement;
    button.addEventListener("click", async () => {
      clearTimeout(timers.get(button));
      let ok = true;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        ok = false;
      }
      const text = (ok ? button.dataset.copied : button.dataset.fallback) ?? "";
      button.textContent = text;
      button.classList.toggle("done", ok);
      let message = text;
      if (message === lastMessage) message += "\u00A0";
      lastMessage = message;
      status.textContent = message;
      timers.set(
        button,
        setTimeout(() => {
          button.textContent = label;
          button.classList.remove("done");
          status.textContent = "";
        }, 1600),
      );
    });
  }
</script>

<style>
  .install {
    max-width: 100%;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.75rem;
  }
  .download {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border-radius: 11px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .download:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
  }
  .brew {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.35rem 0.4rem 0.35rem 0.9rem;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: var(--code-bg);
  }
  .brew code {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.9rem;
  }
  .prompt {
    color: var(--muted);
    user-select: none;
  }
  .copy {
    flex: none;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 550;
    min-width: 4.5rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    border: 0;
    background: var(--surface-strong);
    color: var(--text);
    cursor: pointer;
  }
  .copy:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .copy.done {
    background: var(--accent);
    color: var(--on-accent);
  }
  @media (max-width: 30rem) {
    .brew {
      width: 100%;
    }
    .brew code {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>
