---
import { ui, type Lang } from "../i18n/ui";

const t = ui[Astro.props.lang as Lang].theme;
---

<div class="theme" role="radiogroup" aria-label={t.label}>
  <button type="button" role="radio" data-theme-choice="auto" title={t.autoTitle}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><path d="M8 2a6 6 0 0 1 0 12Z" class="fill" /></svg>
    <span class="visually-hidden">{t.auto}</span>
  </button>
  <button type="button" role="radio" data-theme-choice="light" title={t.light}>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="3" />
      <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13" />
    </svg>
    <span class="visually-hidden">{t.light}</span>
  </button>
  <button type="button" role="radio" data-theme-choice="dark" title={t.dark}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" /></svg>
    <span class="visually-hidden">{t.dark}</span>
  </button>
</div>

<script>
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");

  function apply(choice: string) {
    meta.content = choice === "light" || choice === "dark" ? choice : "light dark";
    for (const button of buttons) button.setAttribute("aria-checked", String(button.dataset.themeChoice === choice));
  }

  function choose(choice: string) {
    apply(choice);
    try {
      if (choice === "auto") localStorage.removeItem("theme");
      else localStorage.setItem("theme", choice);
    } catch {}
  }

  if (!CSS.supports("color", "light-dark(#000, #fff)")) {
    // The colors can't be pinned in this browser; it follows the system.
    document.querySelector<HTMLElement>(".theme")!.hidden = true;
  } else {
    apply(meta.content === "light" || meta.content === "dark" ? meta.content : "auto");
    for (const button of buttons) button.addEventListener("click", () => choose(button.dataset.themeChoice ?? "auto"));
    // Keep other open tabs in step.
    addEventListener("storage", (event) => {
      if (event.key === "theme" || event.key === null) apply(event.newValue ?? "auto");
    });
  }
</script>

<style>
  .theme {
    display: inline-flex;
    padding: 2px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  button {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.6rem;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 7px;
    cursor: pointer;
  }
  button:hover {
    color: var(--text);
  }
  button[aria-checked="true"] {
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  svg .fill,
  button[data-theme-choice="dark"] svg path {
    fill: currentColor;
  }
</style>
