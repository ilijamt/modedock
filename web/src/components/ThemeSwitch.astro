---
import { ui, type Lang } from "../i18n/ui";

const t = ui[Astro.props.lang as Lang].theme;
---

<fieldset class="theme">
  <legend class="visually-hidden">{t.label}</legend>
  <label title={t.autoTitle}>
    <input type="radio" name="theme" value="auto" checked />
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><path d="M8 2a6 6 0 0 1 0 12Z" class="fill" /></svg>
    <span class="visually-hidden">{t.auto}</span>
  </label>
  <label title={t.light}>
    <input type="radio" name="theme" value="light" />
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="3" />
      <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13" />
    </svg>
    <span class="visually-hidden">{t.light}</span>
  </label>
  <label title={t.dark}>
    <input type="radio" name="theme" value="dark" />
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" class="fill" /></svg>
    <span class="visually-hidden">{t.dark}</span>
  </label>
</fieldset>

<script>
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
  const inputs = document.querySelectorAll<HTMLInputElement>('.theme input[name="theme"]');

  function apply(choice: string) {
    meta.content = choice === "light" || choice === "dark" ? choice : "light dark";
    for (const input of inputs) input.checked = input.value === choice;
  }

  function choose(choice: string) {
    apply(choice);
    try {
      if (choice === "auto") localStorage.removeItem("theme");
      else localStorage.setItem("theme", choice);
    } catch {}
  }

  if (!CSS.supports("color", "light-dark(#000, #fff)")) {
    // The colors can't be pinned in this browser; it follows the system.
    document.querySelector<HTMLElement>(".theme")!.hidden = true;
  } else {
    apply(meta.content === "light" || meta.content === "dark" ? meta.content : "auto");
    for (const input of inputs) input.addEventListener("change", () => choose(input.value));
    // Keep other open tabs in step.
    addEventListener("storage", (event) => {
      if (event.key === "theme" || event.key === null) apply(event.newValue ?? "auto");
    });
  }
</script>

<style>
  .theme {
    display: inline-flex;
    margin: 0;
    min-inline-size: 0;
    padding: 2px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  label {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.85rem;
    min-block-size: 1.6rem;
    color: var(--muted);
    border-radius: 7px;
    cursor: pointer;
  }
  /* The radio itself covers the whole label, so it takes the clicks and shows the focus ring. */
  input {
    appearance: none;
    position: absolute;
    inset: 0;
    margin: 0;
    border-radius: inherit;
    cursor: inherit;
  }
  label:hover {
    color: var(--text);
  }
  label:has(:checked) {
    background: var(--bg);
    color: var(--accent);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  svg .fill {
    fill: currentColor;
  }
  /* High Contrast mode drops the background and shadow that mark the choice. */
  @media (forced-colors: active) {
    label:has(:checked) {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
  }
</style>
