---
import { ui, url, type Lang } from "../i18n/ui";

const lang = Astro.props.lang as Lang;
const t = ui[lang].stats;
---

<section class="stats wrap" id="stats" aria-labelledby="stats-title" data-lang={lang} data-strings={JSON.stringify(t)} hidden>
  <h2 id="stats-title">{t.title}</h2>
  <p class="lede"><Fragment set:html={t.lede} /> <a href={url(lang, "privacy")}>{t.how}</a></p>

  <div class="board" data-board>
    <p class="headline" data-headline></p>

    <div class="figures">
      <div class="figure">
        <p class="number" data-count="installs">0</p>
        <p class="caption">{t.installs}</p>
      </div>
      <div class="figure">
        <p class="number" data-count="countries">0</p>
        <p class="caption">{t.countries}</p>
      </div>
      <div class="figure">
        <p class="number" data-count="features">0</p>
        <p class="caption">{t.features}</p>
      </div>
    </div>

    <div class="panels">
      <div class="panel">
        <h3>{t.mostUsed}</h3>
        <p class="hint">{t.hint}</p>
        <ol class="sliders" data-list="features"></ol>
      </div>

      <div class="side">
        <div class="panel">
          <h3>{t.macos}</h3>
          <div class="stack" data-stack role="img"></div>
          <ul class="legend" data-legend></ul>
        </div>
        <div class="panel">
          <h3>{t.countriesTitle}</h3>
          <ol class="sliders compact" data-list="countries"></ol>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Group = { name: string; installs: number; uses?: number };
  type Stats = {
    days: number;
    minimum: number;
    installs: number | null;
    features?: Group[];
    macos?: Group[];
    countries?: Group[];
  };
  type Row = { name: string; installs: number; share: number };


  const section = document.getElementById("stats")!;
  const lang = section.dataset.lang ?? "en";
  const t = JSON.parse(section.dataset.strings ?? "{}") as Record<string, string> & { labels: Record<string, string> };
  const fill = (text: string, values: Record<string, string | number>) =>
    text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ""));
  const countryNames = new Intl.DisplayNames([lang], { type: "region" });
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const format = (n: number) => n.toLocaleString(lang);

  function rows(groups: Group[] | undefined, label: (name: string) => string | null, total: number): Row[] {
    return (groups ?? [])
      .map((group) => ({ name: label(group.name) ?? "", installs: group.installs, share: group.installs / total }))
      .filter((row) => row.name);
  }

  // Drawn like the app's brightness slider.
  function sliders(list: Element, items: Row[], total: number) {
    list.replaceChildren(
      ...items.map((row) => {
        const item = document.createElement("li");
        item.title = fill(t.share, { name: row.name, count: format(row.installs), total: format(total) });
        item.style.setProperty("--share", `${(row.share * 100).toFixed(1)}%`);
        const name = document.createElement("span");
        name.className = "name";
        name.textContent = row.name;
        const value = document.createElement("span");
        value.className = "value";
        value.textContent = `${Math.round(row.share * 100)}%`;
        const track = document.createElement("span");
        track.className = "track";
        track.setAttribute("aria-hidden", "true");
        item.append(name, value, track);
        return item;
      }),
    );
  }

  // "Other" is everything left out for being under the minimum.
  function stack(bar: Element, legend: Element, items: Row[], total: number) {
    const sorted = [...items].sort((a, b) => b.name.localeCompare(a.name, "en", { numeric: true }));
    const other = total - sorted.reduce((sum, row) => sum + row.installs, 0);
    const parts = [
      ...sorted.map((row, index) => ({ ...row, step: index })),
      ...(other > 0 ? [{ name: t.other, installs: other, share: other / total, step: -1 }] : []),
    ];
    const steps = Math.max(sorted.length, 1);
    const tone = (step: number) =>
      step < 0 ? "var(--other)" : `color-mix(in oklab, var(--accent) ${Math.round(100 - (step * 70) / Math.max(steps - 1, 1))}%, var(--surface))`;
    bar.setAttribute("aria-label", parts.map((part) => `macOS ${part.name} ${Math.round(part.share * 100)}%`).join(", "));
    bar.replaceChildren(
      ...parts.map((part) => {
        const segment = document.createElement("span");
        segment.title = fill(t.group, { name: part.name, count: format(part.installs) });
        segment.style.flexGrow = String(part.installs);
        segment.style.background = tone(part.step);
        return segment;
      }),
    );
    legend.replaceChildren(
      ...parts.map((part) => {
        const item = document.createElement("li");
        const swatch = document.createElement("span");
        swatch.className = "swatch";
        swatch.style.background = tone(part.step);
        const name = document.createElement("span");
        name.textContent = part.name;
        const value = document.createElement("span");
        value.className = "value";
        value.textContent = `${Math.round(part.share * 100)}%`;
        item.append(swatch, name, value);
        return item;
      }),
    );
  }

  function countUp(element: Element, target: number) {
    if (still) {
      element.textContent = format(target);
      return;
    }
    const start = performance.now();
    const frame = (now: number) => {
      const t = Math.min(1, (now - start) / 1100);
      element.textContent = format(Math.round(target * (1 - Math.pow(1 - t, 3))));
      if (t < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  function show(stats: Stats, total: number) {
    const features = rows(stats.features, (name) => t.labels[name] ?? null, total);
    const macos = rows(stats.macos, (name) => name, total);
    const countries = rows(stats.countries, (name) => countryNames.of(name) ?? name, total);

    const top = features[0];
    section.querySelector("[data-headline]")!.textContent = top
      ? fill(t.headline, { name: top.name, percent: Math.round(top.share * 100) })
      : "";

    sliders(section.querySelector('[data-list="features"]')!, features.slice(0, 8), total);
    sliders(section.querySelector('[data-list="countries"]')!, countries.slice(0, 6), total);
    stack(section.querySelector("[data-stack]")!, section.querySelector("[data-legend]")!, macos, total);
    for (const list of section.querySelectorAll("[data-list]")) {
      if (!list.children.length) list.closest(".panel")?.setAttribute("hidden", "");
    }
    if (!macos.length) section.querySelector("[data-stack]")!.closest(".panel")?.setAttribute("hidden", "");

    const board = section.querySelector<HTMLElement>("[data-board]")!;
    section.hidden = false;

    const figures: [string, number][] = [
      ["installs", total],
      ["countries", countries.length],
      ["features", features.filter((row) => row.share >= 0.25).length],
    ];
    const reveal = () => {
      board.classList.add("in");
      for (const [key, value] of figures) countUp(section.querySelector(`[data-count="${key}"]`)!, value);
    };
    if (still) return reveal();
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        requestAnimationFrame(reveal);
      },
      { threshold: 0.2 },
    );
    observer.observe(board);
  }

  async function load() {
    try {
      const response = await fetch(import.meta.env.PUBLIC_STATS_URL ?? "https://telemetry.modedock.app/v1/stats");
      if (!response.ok) return;
      const stats: Stats = await response.json();
      section.querySelector("[data-days]")!.textContent = String(stats.days);
      for (const minimum of section.querySelectorAll("[data-minimum]")) minimum.textContent = String(stats.minimum);
      if (stats.installs) show(stats, stats.installs);
    } catch {
      // The section stays hidden.
    }
  }

  load();
</script>

<style>
  .stats {
    --other: color-mix(in oklab, var(--muted) 35%, var(--surface));
    padding-top: clamp(4rem, 9vw, 6rem);
  }
  h2 {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
  }
  .lede {
    margin-top: 0.75rem;
    max-width: 40rem;
    color: var(--muted);
  }

  .headline {
    margin-top: 2rem;
    font: 650 clamp(1.25rem, 2.4vw, 1.6rem) / 1.3 var(--font-display);
    letter-spacing: -0.015em;
    max-width: 40rem;
  }

  .figures {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    border-block: 1px solid var(--line);
  }
  .figure {
    padding: 1.4rem 1.5rem 1.4rem 0;
  }
  .figure + .figure {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .number {
    font: 750 clamp(2.5rem, 6vw, 3.75rem) / 1 var(--font-display);
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }
  .caption {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .panels {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .side {
    display: grid;
    gap: 1rem;
  }
  .panel {
    padding: 1.25rem 1.35rem 1.4rem;
    border-radius: var(--radius);
    background: var(--surface);
  }
  h3 {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .hint {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .sliders {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }
  .sliders.compact {
    gap: 0.8rem;
  }
  .sliders :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    row-gap: 0.45rem;
    font-size: 0.93rem;
  }
  .sliders :global(.name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sliders :global(.value) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .sliders :global(.track) {
    grid-column: 1 / -1;
    position: relative;
    height: 4px;
    margin-inline: 7px;
    border-radius: 2px;
    background: var(--surface-strong);
  }
  .sliders :global(.track)::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 2px;
    background: var(--accent);
  }
  .sliders :global(.track)::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.2),
      0 1px 3px rgb(0 0 0 / 0.3);
    transform: translate(-50%, -50%);
  }
  .in .sliders :global(.track)::before {
    width: var(--share);
  }
  .in .sliders :global(.track)::after {
    left: var(--share);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sliders :global(.track)::before,
    .sliders :global(.track)::after {
      transition:
        width 1.1s cubic-bezier(0.16, 1, 0.3, 1),
        left 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sliders :global(li:nth-child(2) .track)::before,
    .sliders :global(li:nth-child(2) .track)::after {
      transition-delay: 70ms;
    }
    .sliders :global(li:nth-child(3) .track)::before,
    .sliders :global(li:nth-child(3) .track)::after {
      transition-delay: 140ms;
    }
    .sliders :global(li:nth-child(4) .track)::before,
    .sliders :global(li:nth-child(4) .track)::after {
      transition-delay: 210ms;
    }
    .sliders :global(li:nth-child(n + 5) .track)::before,
    .sliders :global(li:nth-child(n + 5) .track)::after {
      transition-delay: 280ms;
    }
  }

  .stack {
    margin-top: 1rem;
    display: flex;
    gap: 2px;
    height: 14px;
  }
  .stack :global(span) {
    min-width: 4px;
    border-radius: 4px;
  }
  .legend {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.93rem;
  }
  .legend :global(li) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
  }
  .legend :global(.swatch) {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .legend :global(.value) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 52rem) {
    .panels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 34rem) {
    .figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .figure {
      padding-right: 0.75rem;
    }
    .figure + .figure {
      padding-left: 0.75rem;
    }
    .number {
      font-size: 2rem;
    }
    .caption {
      font-size: 0.85rem;
    }
  }
</style>
