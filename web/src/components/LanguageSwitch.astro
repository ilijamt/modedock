---
import { languages, ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  alternates: Record<string, string>;
}

const { lang, alternates } = Astro.props;
---

<div class="language">
  <button type="button" class="trigger" popovertarget="language-menu" title={ui[lang].nav.language}>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="6.2" />
      <path d="M1.8 8h12.4M8 1.8c1.7 1.8 2.5 3.9 2.5 6.2S9.7 12.4 8 14.2C6.3 12.4 5.5 10.3 5.5 8S6.3 3.6 8 1.8Z" />
    </svg>
    <span class="visually-hidden">{ui[lang].nav.language}</span>
    <span class="code">{lang.toUpperCase()}</span>
  </button>
  <ul id="language-menu" popover="auto" role="list">
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <li>
          <a href={alternates[code]} hreflang={code} lang={code} data-lang={code} aria-current={code === lang ? "true" : undefined}>
            {languages[code]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(".language .trigger")!;
  const menu = document.getElementById("language-menu")!;

  for (const link of menu.querySelectorAll<HTMLAnchorElement>("a[data-lang]")) {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("lang", link.dataset.lang ?? "");
      } catch {}
    });
  }

  // Popovers close on outside clicks and Escape, but not when Tab moves focus past the last language.
  menu.addEventListener("focusout", (event) => {
    const to = event.relatedTarget as Node | null;
    if (to && to !== trigger && !menu.contains(to)) menu.hidePopover();
  });

  // Without anchor positioning the popover would open centred on the page, so pin it under the button.
  if (!CSS.supports("position-area", "block-end")) {
    const place = () => {
      const box = trigger.getBoundingClientRect();
      menu.style.top = `${box.bottom + 6}px`;
      menu.style.right = `${document.documentElement.clientWidth - box.right}px`;
    };
    // beforetoggle, not toggle: toggle fires after the menu is already painted in the wrong place.
    menu.addEventListener("beforetoggle", (event) => {
      if ((event as ToggleEvent).newState === "open") place();
    });
    addEventListener("resize", () => {
      if (menu.matches(":popover-open")) place();
    });
  }
</script>

<style>
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-block-size: calc(1.6rem + 6px);
    padding: 0 0.55rem;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .trigger:hover,
  .language:has(:popover-open) .trigger {
    color: var(--text);
  }
  svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }
  ul {
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: 9rem;
    padding: 0.3rem;
    list-style: none;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  @supports (position-area: block-end) {
    ul {
      position-area: block-end span-inline-start;
      position-try-fallbacks: flip-inline;
      margin-top: 6px;
    }
  }
  /* Browsers without popovers keep the list closed; the links still exist in every page's hreflang alternates. */
  @supports not selector(:popover-open) {
    ul {
      display: none;
    }
  }
  a {
    display: block;
    padding: 0.4rem 0.65rem;
    border-radius: 7px;
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }
  a:hover {
    background: var(--surface);
  }
  a[aria-current="true"] {
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 30rem) {
    .trigger .code {
      display: none;
    }
  }
</style>
