---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  tab: string;
  alt: string;
  eager?: boolean;
  width?: number;
}

const { tab, alt, eager = false, width = 320 } = Astro.props;
const panels = import.meta.glob<{ default: ImageMetadata }>("../assets/panels/*.png", { eager: true });
const panel = (scheme: string) => {
  const image = panels[`../assets/panels/panel-${tab}-${scheme}.png`];
  if (!image) throw new Error(`Missing screenshot panel-${tab}-${scheme}.png`);
  return image.default;
};
const loading = eager ? "eager" : "lazy";
// Only one of the pair is visible, but HTML can't tell which before CSS runs, so both get the boost.
const fetchpriority = eager ? "high" : undefined;
// The light/dark classes sit on the <img>; the <picture> wrapper stays out of layout.
const pictureAttributes = { style: "display: contents" };
---

{
  ["light", "dark"].map((scheme) => (
    <Picture
      src={panel(scheme)}
      formats={["avif", "webp"]}
      densities={[1, 2]}
      width={width}
      alt={alt}
      class:list={["shot", `only-${scheme}`]}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      pictureAttributes={pictureAttributes}
    />
  ))
}

<style>
  :global(img.shot) {
    max-width: 100%;
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
</style>
